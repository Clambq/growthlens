relationship DailyKPI_Date
	fromColumn: 'Daily KPI'.metric_date
	toColumn: 'Dim Date'.Date

relationship Delivery_Date
	fromColumn: 'Delivery Summary'.purchase_date
	toColumn: 'Dim Date'.Date

relationship ExperimentSummary_Segment
	fromColumn: 'Experiment Summary'.segment
	toColumn: 'Dim Experiment Segment'.segment

relationship ExperimentQuality_Segment
	fromColumn: 'Experiment Quality'.segment
	toColumn: 'Dim Experiment Segment'.segment
